---
interface Props {
  class?: string;
}

// Destructure the class prop so developers can pass extra custom Tailwind classes if needed
const { class: className, ...rest } = Astro.props;
---

<div 
  class:list={[
    "w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8", 
    className
  ]} 
  {...rest}
>
  <slot />
</div>