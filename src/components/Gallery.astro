---
const createImage = (emoji, title, color) =>
  `data:image/svg+xml,${encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="600" height="320" viewBox="0 0 600 320">
      <rect width="600" height="320" rx="24" fill="#0f172a"/>
      <circle cx="300" cy="140" r="80" fill="${color}" opacity="0.25"/>
      <text x="300" y="150" text-anchor="middle" font-size="70">${emoji}</text>
      <text x="300" y="240" text-anchor="middle" fill="white" font-size="28" font-family="Arial">${title}</text>
    </svg>
  `)}`;

const galleryItems = [
  {
    title: "Student Project",
    description: "A project created by NSC Tech Hub students.",
    image: createImage("🌳", "Student Project", "#2563eb"),
    alt: "Tree inspired student project preview",
  },
  {
    title: "Team Collaboration",
    description: "Students working together across design, business, and tech.",
    image: createImage("🤝", "Team Collaboration", "#16a34a"),
    alt: "Team collaboration preview",
  },
  {
    title: "Creative Work",
    description: "A preview of student-led creative and technical work.",
    image: createImage("🤖", "Creative AI Work", "#7c3aed"),
    alt: "AI creative work preview",
  },
];
---

<section
  class="border-t border-white/10 px-4 pt-16 pb-8 text-center sm:px-6 sm:pt-20 sm:pb-10"
>
  <h2 class="text-3xl font-bold text-white sm:text-4xl">Gallery</h2>
  <p class="mt-3 text-base text-slate-400 sm:text-lg">
    Explore student projects and Tech Hub activities.
  </p>

  <div
    class="mx-auto mt-10 grid max-w-6xl grid-cols-1 gap-6 sm:mt-12 md:grid-cols-3"
  >
    {
      galleryItems.map((item) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-4 text-left transition hover:-translate-y-1 hover:border-blue-500/30 hover:shadow-lg hover:shadow-blue-500/5">
          <img
            src={item.image}
            alt={item.alt}
            class="h-40 w-full rounded-lg object-cover"
          />
          <h3 class="mt-4 text-lg font-semibold text-white">{item.title}</h3>
          <p class="mt-1 text-sm text-slate-400">{item.description}</p>
        </article>
      ))
    }
  </div>
</section>
