---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  imageSrc?: string;
  imageAlt?: string;
  reverse?: boolean;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  imageSrc,
  imageAlt = "",
  reverse = false,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "grid gap-10 items-center lg:grid-cols-2 lg:gap-16",
    reverse && "lg:[&>*:first-child]:order-2",
    className,
  ]}
  {...rest}
>
  <div
    class="aspect-video w-full overflow-hidden rounded-2xl border border-white/10 bg-white/5"
  >
    {
      imageSrc ? (
        <img
          src={imageSrc}
          alt={imageAlt}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <span class="text-sm text-white/40">Image coming soon</span>
        </div>
      )
    }
  </div>

  <div>
    {
      eyebrow && (
        <p class="mb-3 text-sm uppercase tracking-widest text-white/50">
          {eyebrow}
        </p>
      )
    }

    <h2 class="text-3xl font-bold text-white sm:text-4xl">
      {title}
    </h2>

    <p class="mt-4 text-base leading-7 text-slate-400 sm:text-lg sm:leading-8">
      {description}
    </p>
  </div>
</div>
