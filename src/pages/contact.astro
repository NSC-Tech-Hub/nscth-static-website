---
import BaseLayout from "../layouts/BaseLayout.astro";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Contact | NSC Tech Hub"
  description="Get in touch with NSC Tech Hub at North Seattle College."
>
  <div class="contact-page">
    <section class="hero">
      <h1>Interested in Working with the Tech Hub?</h1>
      <p>
        The North Seattle Tech Hub is always looking to connect with new people.
        If you are interested, please fill out the form below.
      </p>
    </section>

    <section class="contact-layout">
      <aside class="contact-info self-start space-y-4 leading-relaxed text-slate-300">
        <h2 class="text-2xl font-bold text-white">Get Involved</h2>
        <p>
          Tell us what you’d like to work on or how we can help. The Tech Hub
          team will review your message and use the email address you provide
          to follow up.
        </p>
        <p>
          If you can’t use the form, email
          <a class="break-all text-blue-300 underline" href="mailto:techhub@northseattle.edu">techhub@northseattle.edu</a>.
        </p>
        <p>
          To explore our projects and find ways to contribute, visit the
          <a class="text-blue-300 underline" href="https://github.com/NSC-Tech-Hub">NSC Tech Hub on GitHub</a>.
        </p>
      </aside>

      <form class="contact-form" id="contact-form">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter your name"
          required
          maxlength="100"
          autocomplete="name"
        />

        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="Enter your email"
          required
          maxlength="254"
          autocomplete="email"
        />

        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          maxlength="2000"
          rows="6"
          placeholder="Type your message"
          required></textarea>

        <div class="honeypot" aria-hidden="true" inert>
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        {turnstileSiteKey ? (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact"></div>
        ) : (
          <p>Contact verification is unavailable. Please try again later.</p>
        )}

        <button disabled={!turnstileSiteKey} type="submit" id="submit-btn">Send Message</button>

        <p id="status" class="status" role="status" aria-live="polite" aria-atomic="true"></p>
      </form>
    </section>
  </div>
  {turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</BaseLayout>

<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("status");
  const button = document.getElementById("submit-btn");

  if (form instanceof HTMLFormElement && status && button instanceof HTMLButtonElement) {
    const idleLabel = button.textContent;

    function showStatus(region: HTMLElement, message: string, state?: "success" | "error") {
      region.classList.toggle("text-green-400", state === "success");
      region.classList.toggle("text-red-400", state === "error");
      region.textContent = message;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled) return;

      const fields = new FormData(form);
      const token = fields.get("cf-turnstile-response");
      if (!token) {
        showStatus(status, "Please complete the verification before sending.", "error");
        return;
      }

      const payload = {
        website: fields.get("website"),
        turnstileToken: token,
        name: fields.get("name"),
        email: fields.get("email"),
        message: fields.get("message"),
      };

      button.disabled = true;
      button.textContent = "Sending...";
      showStatus(status, "Sending...");

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (response.ok) {
          form.reset();
          showStatus(status, "Message sent successfully!", "success");
        } else {
          const data = await response.json().catch(() => null);
          const message = typeof data?.error === "string" && data.error
            ? data.error
            : "Something went wrong. Please try again.";
          showStatus(status, message, "error");
        }
      } catch {
        showStatus(status, "Network error. Please try again.", "error");
      } finally {
        button.textContent = idleLabel;
        button.disabled = false;
        // Tokens are single-use, including after downstream failures.
        (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
      }
    });
  }
</script>

<style>
  .honeypot {
    display: none;
  }

  .contact-page {
    min-height: 100vh;
    background: #050816;
    color: white;
    padding: 4rem 1rem;
  }

  .hero {
    max-width: 900px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .hero p {
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 700px;
    margin: auto;
  }

  .contact-layout {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .contact-info,
  .contact-form {
    background: #0f172a;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #1e293b;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
  }

  .contact-form label {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .contact-form input,
  .contact-form textarea {
    margin-bottom: 1.2rem;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid #334155;
    background: #020617;
    color: white;
  }

  .contact-form button {
    padding: 1rem;
    border: none;
    border-radius: 12px;
    background: #2563eb;
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .contact-form button:disabled {
    background: #1e3a8a;
    color: #e2e8f0;
    cursor: not-allowed;
  }

  .status {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
