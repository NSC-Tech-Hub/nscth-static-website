---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | NSC Tech Hub"
  description="Get in touch with NSC Tech Hub at North Seattle College."
>
  <main class="contact-page">
    <section class="hero">
      <h1>Interested in Working with the Tech Hub?</h1>
      <p>
        The North Seattle Tech Hub is always looking to connect with new people.
        If you are interested, please fill out the form below.
      </p>
    </section>

    <section class="contact-layout">
      <div class="image-box">
        <div class="placeholder-image">
          <img src="/Logo.png" alt="NSC Tech Hub Logo" />
        </div>
        <div class="info-text">
          <h2>Collaborate With Us</h2>
          <p>
            NSC Tech Hub connects students, technology, and creative projects
            together through collaboration and innovation.
          </p>
        </div>
      </div>

      <form class="contact-form" id="contact-form">
        <label for="name">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          placeholder="Enter your name"
          required
          autocomplete="name"
        />

        <label for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          placeholder="Enter your email"
          required
          autocomplete="email"
        />

        <label for="message">Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="Type your message"
          required></textarea>

        <button type="submit" id="submit-btn">Send Message</button>

        <p id="status" class="status"></p>
      </form>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("status");
  const button = document.getElementById("submit-btn");

  const clearStatus = () => {
    setTimeout(() => {
      status.textContent = "";
      status.style.color = "";
    }, 5000);
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (button.disabled) return;

    button.disabled = true;
    status.textContent = "Sending...";

    const payload = {
      name: document.getElementById("name").value,
      email: document.getElementById("email").value,
      message: document.getElementById("message").value,
    };

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data = {};
      try {
        data = await res.json();
      } catch {}

      if (res.ok) {
        status.textContent = "Message sent successfully!";
        status.style.color = "#22c55e";
        form.reset();
        clearStatus();
      } else {
        status.textContent = data.error || "Something went wrong";
        status.style.color = "#ef4444";
        clearStatus();
      }
    } catch (err) {
      status.textContent = "Network error";
      status.style.color = "#ef4444";
      clearStatus();
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .contact-page {
    min-height: 100vh;
    background: #050816;
    color: white;
    padding: 4rem 1rem;
  }

  .hero {
    max-width: 900px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  .hero p {
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 700px;
    margin: auto;
  }

  .contact-layout {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .image-box,
  .contact-form {
    background: #0f172a;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid #1e293b;
  }

  .placeholder-image {
    height: 320px;
    border: 2px dashed #475569;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    background: #111827;
  }

  .placeholder-image img {
    width: 180px;
    height: auto;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
  }

  .contact-form label {
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .contact-form input,
  .contact-form textarea {
    margin-bottom: 1.2rem;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid #334155;
    background: #020617;
    color: white;
  }

  .contact-form button {
    padding: 1rem;
    border: none;
    border-radius: 12px;
    background: #2563eb;
    color: white;
    font-weight: 700;
    cursor: pointer;
  }

  .contact-form button:disabled {
    background: #1e3a8a;
    color: #64748b;
  }

  .status {
    margin-top: 1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
