---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Contact | NSC Tech Hub"
  description="Contact NSC Tech Hub for inquiries, support, or collaboration opportunities. We're here to help and connect with you."
  url="https://nscth-static-website.pages.dev/contact"
>
  <Header />
  <main class="max-w-2xl mx-auto p-6">
    <h1 class="text-2xl mb-4">Contact Us</h1>

    <article class="rounded-2xl border border-white/10 bg-white/5 p-6">
      <form class="flex flex-col gap-4" method="POST">
        
        <label class="flex flex-col gap-1">
          Name
          <input class="p-2 rounded bg-black/20 border border-white/10" type="text" name="name" required />
        </label>

        <label class="flex flex-col gap-1">
          Email
          <input class="p-2 rounded bg-black/20 border border-white/10" type="email" name="email" required />
        </label>

        <label class="flex flex-col gap-1">
          Message
          <textarea class="p-2 rounded bg-black/20 border border-white/10" name="message" rows="5" required></textarea>
        </label>

        <button class="bg-white text-black rounded p-2 mt-2" type="submit">
          Send
        </button>

      </form>
    </article>
  </main>
  <Footer />
</BaseLayout>